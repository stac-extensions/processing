{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://stac-extensions.github.io/processing/v1.2.0/schema.json#",
  "title": "Processing Extension",
  "description": "STAC Processing Extension for STAC Items and STAC Collections.",
  "type": "object",
  "required": [
    "stac_extensions",
    "type"
  ],
  "properties": {
    "stac_extensions": {
      "type": "array",
      "contains": {
        "const": "https://stac-extensions.github.io/processing/v1.2.0/schema.json"
      }
    },
    "type": {
      "type": "string",
      "enum": [
        "Collection",
        "Feature"
      ]
    },
    "assets": {
      "$comment": "This validates the fields in Item and Collection Assets, but does not require them.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/fieldsAndProviders"
      }
    },
    "assetTemplates": {
      "$comment": "This validates the fields in Asset Templates, but does not require them.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/fieldsAndProviders"
      }
    }
  },
  "oneOf": [
    {
      "$comment": "This is the schema for STAC Items.",
      "type": "object",
      "required": [
        "type",
        "properties"
      ],
      "properties": {
        "type": {
          "const": "Feature"
        },
        "properties": {
          "$ref": "#/definitions/fieldsAndProviders"
        }
      }
    },
    {
      "$comment": "This is the schema for STAC Collections.",
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "Collection"
        },
        "providers": {
          "$ref": "#/definitions/providers"
        },
        "summaries": {
          "$ref": "#/definitions/summaries"
        },
        "item_assets": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/fieldsAndProviders"
          }
        }
      }
    }
  ],
  "definitions": {
    "processing:expression": {
      "title": "Processing Expression",
      "type": "object",
      "required": [
        "format",
        "expression"
      ],
      "properties": {
        "format": {
          "type": "string"
        },
        "expression": {
          "description": "Any data type, depending on the format chosen."
        }
      }
    },
    "processing:lineage": {
      "title": "Processing Lineage Information",
      "type": "string",
      "examples": [
        "Post Processing GRD"
      ]
    },
    "processing:level": {
      "title": "Processing Level",
      "type": "string",
      "examples": [
        "RAW",
        "L1",
        "L1A",
        "L1B",
        "L1C",
        "L2",
        "L2A",
        "L3",
        "L4"
      ]
    },
    "processing:facility": {
      "title": "Processing Facility",
      "type": "string",
      "examples": [
        "Copernicus S1 Core Ground Segment - DPA"
      ]
    },
    "processing:version": {
      "title": "Processing Version",
      "type": "string",
      "examples": [
        "0.2.0"
      ]
    },
    "processing:datetime": {
      "title": "Processing Datetime",
      "type": "string",
      "format": "date-time",
      "pattern": "(\\+00:00|Z)$",
      "examples": [
        "2020-01-05T12:34:55Z"
      ]
    },
    "processing:software": {
      "title": "Processing Software Name / version",
      "type": "object",
      "patternProperties": {
        ".{1,}": {
          "type": "string"
        }
      },
      "examples": [
        {
          "Sentinel-1 IPF": "002.71"
        }
      ]
    },
    "processing:datastrip_id": {
      "title": "Datastrip ID",
      "type": "string",
      "minLength": 1,
      "examples": [
        "S2A_OPER_MSI_L2A_DS_2APS_20250626T142217_S20250626T102649_N05.11"
      ]
    },
    "fields": {
      "$comment": "Don't require fields here as they would be required in all places where the fields are referenced.",
      "type": "object",
      "properties": {
        "processing:expression": {
          "$ref": "#/definitions/processing:expression"
        },
        "processing:lineage": {
          "$ref": "#/definitions/processing:lineage"
        },
        "processing:level": {
          "$ref": "#/definitions/processing:level"
        },
        "processing:facility": {
          "$ref": "#/definitions/processing:facility"
        },
        "processing:version": {
          "$ref": "#/definitions/processing:version"
        },
        "processing:datetime": {
          "$ref": "#/definitions/processing:datetime"
        },
        "processing:software": {
          "$ref": "#/definitions/processing:software"
        },
        "processing:datastrip_id": {
          "$ref": "#/definitions/processing:datastrip_id"
        }
      },
      "patternProperties": {
        "^(?!processing:)": {}
      },
      "additionalProperties": false
    },
    "providers": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/fields"
      }
    },
    "fieldsAndProviders": {
      "allOf": [
        {
          "$ref": "#/definitions/fields"
        },
        {
          "properties": {
            "providers": {
              "$ref": "#/definitions/providers"
            }
          }
        }
      ]
    },
    "summaries": {
      "$comment": "Summaries can be lists, ranges (only for processing:datetime) or JSON Schemas. Only lists and ranges are validated.",
      "type": "object",
      "properties": {
        "processing:expression": {
          "type": ["array", "object"],
          "items": {
            "$ref": "#/definitions/processing:expression"
          }
        },
        "processing:lineage": {
          "type": ["array", "object"],
          "items": {
            "$ref": "#/definitions/processing:lineage"
          }
        },
        "processing:level": {
          "type": ["array", "object"],
          "items": {
            "$ref": "#/definitions/processing:level"
          }
        },
        "processing:facility": {
          "type": ["array", "object"],
          "items": {
            "$ref": "#/definitions/processing:facility"
          }
        },
        "processing:version": {
          "type": ["array", "object"],
          "items": {
            "$ref": "#/definitions/processing:version"
          }
        },
        "processing:datetime": {
          "type": ["array", "object"],
          "items": {
            "$ref": "#/definitions/processing:datetime"
          },
          "properties": {
            "minimum": {
              "$ref": "#/definitions/processing:datetime"
            },
            "maximum": {
              "$ref": "#/definitions/processing:datetime"
            }
          }
        },
        "processing:software": {
          "type": ["array", "object"],
          "items": {
            "$ref": "#/definitions/processing:software"
          }
        },
        "processing:datastrip_id": {
          "type": ["array", "object"],
          "items": {
            "$ref": "#/definitions/processing:datastrip_id"
          }
        }
      },
      "patternProperties": {
        "^(?!processing:)": {}
      },
      "additionalProperties": false
    }
  }
}
